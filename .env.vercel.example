# Environment variables for the BACKEND Vercel project (repo root, vercel_app.py).
# Set these in Vercel -> Project -> Settings -> Environment Variables.
# Full walkthrough: docs/DEPLOY_VERCEL.md

# --- Required -----------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false

# Long random string; guards the internal /_svc/* routes. e.g. `openssl rand -hex 32`
INTERNAL_API_TOKEN=
# Long random string, different from the above
JWT_SECRET=

# Postgres (e.g. Neon). Must use the asyncpg driver prefix; for SSL use ?ssl=require
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DB?ssl=require
# Redis (e.g. Upstash, TCP/TLS URL). Used for auth tokens AND live pipeline events.
REDIS_URL=rediss://default:PASSWORD@HOST:6379

# Qdrant (e.g. Qdrant Cloud) holding the re-embedded knowledge base
QDRANT_URL=https://CLUSTER.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=futbot_chunks

# Embeddings -- must match what scripts/reembed_qdrant.py used
EMBEDDING_API_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# LLM
LLM_PROVIDER=groq
GROQ_API_KEY=

# Public URL of the FRONTEND project (OAuth redirects, emails)
WEB_APP_URL=https://YOUR-FRONTEND.vercel.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-FRONTEND.vercel.app/api/auth/oauth/google/callback

# --- Fixed for Vercel (keep as-is) ------------------------------------------------
KNOWLEDGE_UPLOADS_ENABLED=false
INGEST_OCR_ENABLED=false
# Python runtime has no Node.js, so the stdio API-Football MCP cannot start
API_FOOTBALL_MCP_ENABLED=false
TRACING_ENABLED=false
PIPELINE_INLINE=true
SETTINGS_API_KEYS_ENABLED=false
# Must stay below the function maxDuration in vercel.json (300s)
SSE_MAX_SECONDS=240

# --- Optional ---------------------------------------------------------------------
TAVILY_API_KEY=
SERPER_API_KEY=
LIVESCORE_MCP_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# File storage for previously uploaded project/KB files (S3-compatible, e.g. R2)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=futbot-projects
MINIO_SECURE=true
# Only if the internal self-calls must target a different host than VERCEL_URL
# INTERNAL_API_BASE_URL=https://api.example.com
